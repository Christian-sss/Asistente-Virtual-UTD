<%@ page pageEncoding="UTF-8" %>
<div class="encabezado-pagina pb-0">
    <div class="container">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
            <h1><i class="bi bi-speedometer2"></i> Panel de administración</h1>
            <span class="badge text-bg-primary fs-6"><i class="bi bi-person-badge"></i> <c:out value="${usr.nombreCompleto}"/> &middot; <c:out value="${usr.rol}"/></span>
        </div>
        <ul class="nav nav-tabs border-0 flex-nowrap overflow-auto">
            <li class="nav-item"><a class="nav-link text-nowrap ${seccion == 'panel' ? 'active' : ''}" href="${ctx}/admin">Resumen</a></li>
            <li class="nav-item"><a class="nav-link text-nowrap ${seccion == 'tramites' ? 'active' : ''}" href="${ctx}/admin/tramites">Trámites</a></li>
            <c:if test="${usr.rol == 'ADMIN_CONTENIDOS'}">
                <li class="nav-item"><a class="nav-link text-nowrap ${seccion == 'categorias' ? 'active' : ''}" href="${ctx}/admin/categorias">Categorías</a></li>
                <li class="nav-item"><a class="nav-link text-nowrap ${seccion == 'preguntas' ? 'active' : ''}" href="${ctx}/admin/preguntas">Preguntas guiadas</a></li>
                <li class="nav-item"><a class="nav-link text-nowrap ${seccion == 'normativas' ? 'active' : ''}" href="${ctx}/admin/normativas">Normativas</a></li>
                <li class="nav-item"><a class="nav-link text-nowrap ${seccion == 'ubicaciones' ? 'active' : ''}" href="${ctx}/admin/ubicaciones">Ubicaciones y canales</a></li>
                <li class="nav-item"><a class="nav-link text-nowrap ${seccion == 'derivacion' ? 'active' : ''}" href="${ctx}/admin/derivacion">Derivación</a></li>
                <li class="nav-item"><a class="nav-link text-nowrap ${seccion == 'usuarios' ? 'active' : ''}" href="${ctx}/admin/usuarios">Usuarios</a></li>
            </c:if>
            <li class="nav-item"><a class="nav-link text-nowrap ${seccion == 'validacion' ? 'active' : ''}" href="${ctx}/admin/validacion">Validación</a></li>
            <li class="nav-item"><a class="nav-link text-nowrap ${seccion == 'reportes' ? 'active' : ''}" href="${ctx}/admin/reportes">Reportes</a></li>
            <li class="nav-item"><a class="nav-link text-nowrap ${seccion == 'bitacora' ? 'active' : ''}" href="${ctx}/admin/bitacora">Bitácora</a></li>
        </ul>
    </div>
</div>
